DATABASE_URL=sqlite:///./kitchen_handover.db

# Dev-only insecure default below. In production, set this to a long random
# value and keep it out of Git: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=dev-only-insecure-secret-change-me

# Leave false for local/LAN HTTP testing. Set to true once the app is
# actually served over HTTPS — otherwise the session cookie won't be set.
COOKIE_SECURE=false

# When the kitchen's working day actually starts (Europe/Berlin), not when
# the calendar rolls over. A placeholder until the real restaurant workflow
# is confirmed — see "Operational (business) day" in README.md.
OPERATIONAL_DAY_CUTOFF=04:00
